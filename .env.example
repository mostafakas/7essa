# ================= قاعدة البيانات =================
POSTGRES_USER=hessa_owner
POSTGRES_PASSWORD=__OWNER_PASSWORD__
POSTGRES_DB=hessa
APP_DB_PASSWORD=__APP_PASSWORD__
# حساب المالك: للترحيلات (migrations) فقط
MIGRATION_DATABASE_URL=postgresql://hessa_owner:__OWNER_PASSWORD__@localhost:5432/hessa
# حساب التطبيق: صلاحيات محدودة وسياسات عزل الصفوف (RLS) تُطبق عليه
DATABASE_URL=postgresql://hessa_app:__APP_PASSWORD__@localhost:5432/hessa

REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_URL=redis://:__REDIS_PASSWORD__@localhost:6379

# ================= الخادم (API) =================
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# اجعلها true في الإنتاج (HTTPS)
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=__SECRET__
OTP_PEPPER=__SECRET__
QR_SECRET=__SECRET__

# ================= الواجهة (Web) =================
API_INTERNAL_URL=http://localhost:4000
