# ═══════════════ قاعدة البيانات (Neon) ═══════════════
# على Vercel: تُضاف DATABASE_URL و DATABASE_URL_UNPOOLED تلقائيًا عند ربط قاعدة Neon
# من تبويب Storage في مشروع الخادم. محليًا: انسخ روابط فرع تطوير من Neon (Branches)
# أو استخدم PostgreSQL مثبتًا على جهازك (الرابطان متطابقان وقتها).

# رابط المالك المباشر (بدون pooler): للترحيلات والبيانات التجريبية فقط
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# الرابط عبر الـpooler: الخادم يستبدل اسم المستخدم فيه بالدور المقيد hessa_app تلقائيًا
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/neondb?sslmode=require
# كلمة مرور الدور المقيد hessa_app (ينشئه/يحدّثه أمر db:migrate أو بناء الإنتاج)
APP_DB_PASSWORD=__SECRET__

# ═══════════════ الخادم (API) ═══════════════
NODE_ENV=development
PORT=4000
# نطاق الواجهة (أكثر من نطاق مفصولة بفاصلة)
WEB_ORIGIN=http://localhost:3000
# true في الإنتاج (HTTPS)
COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
JWT_ACCESS_SECRET=__SECRET__
QR_SECRET=__SECRET__
# المهمة اليومية (Vercel Cron يرسلها تلقائيًا)
CRON_SECRET=__SECRET__
# سر مشترك بين الواجهة والخادم لتمرير عنوان العميل (نفس القيمة في المشروعين)
PROXY_SHARED_SECRET=__SECRET__
# true في الإنتاج: رفض أي طلب لا يمر عبر الواجهة
REQUIRE_PROXY=false

# مالك المنصة الأول (يُنشأ مرة واحدة إن لم يوجد مالك)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=__ADMIN_PASSWORD__
BOOTSTRAP_ADMIN_NAME=إدارة منصة حصّة
# BOOTSTRAP_ADMIN_PHONE=01000000000
# للاسترجاع إن فُقدت كلمة المرور: true ثم أعد النشر ثم احذفها
# BOOTSTRAP_ADMIN_RESET=true

# ═══════════════ الواجهة (Web) ═══════════════
# رابط مشروع الخادم (على Vercel: https://hessa-api.vercel.app مثلًا)
API_INTERNAL_URL=http://localhost:4000
